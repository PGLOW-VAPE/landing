---
type GradientVariant = "hero" | "section";

interface Props {
  variant?: GradientVariant;
}

const { variant = "section" } = Astro.props;

const gradientLayers: Record<GradientVariant, string[]> = {
  hero: [
    "absolute inset-0 -z-10 bg-linear-to-b from-surface via-primary/25 to-surface lg:bg-[linear-gradient(90deg,rgba(0,0,0,0.86)_0%,rgba(0,0,0,0.66)_45%,rgba(0,0,0,0.28)_100%)]",
    "absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_38%,rgba(28,77,141,0.26),transparent_42%)] lg:bg-[radial-gradient(circle_at_78%_42%,rgba(28,77,141,0.34),transparent_38%)]",
  ],
  section: [
    "absolute inset-0 -z-10 bg-linear-to-b from-surface via-primary/20 to-surface lg:bg-[linear-gradient(90deg,rgba(0,0,0,0.86)_0%,rgba(0,0,0,0.66)_45%,rgba(0,0,0,0.28)_100%)]",
    "absolute inset-x-0 top-0 -z-10 h-px bg-linear-to-r from-transparent via-primary/70 to-transparent",
  ],
};
---

{
  gradientLayers[variant].map((layerClass) => (
    <div aria-hidden="true" class={layerClass} />
  ))
}
