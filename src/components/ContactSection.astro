---
import GradientBackground from "./GradientBackground.astro";

const contactMethods = [
  {
    title: "Habla con nosotros",
    description:
      "Resuelve dudas de compra, uso y soporte técnico por WhatsApp.",
    href: "https://wa.me/3143267025",
    label: "WhatsApp",
    icon: "whatsapp",
  },
  {
    title: "Síguenos en Instagram",
    description:
      "Mira novedades, avances del producto y contenido de la comunidad.",
    href: "https://www.instagram.com/transformit_sas?igsh=MTRoamV4NGRjNmE0eA==",
    label: "Instagram",
    icon: "instagram",
  },
  {
    title: "Mira tutoriales y contenido",
    description:
      "Aprende a usar PGLOW y descubre consejos para mejores sesiones.",
    href: "https://www.youtube.com/@KevinCuellar-d9l",
    label: "YouTube",
    icon: "youtube",
  },
  {
    title: "Soporte por correo",
    description:
      "Escríbenos para garantías, repuestos o asistencia personalizada.",
    href: "mailto:kevin.transformit@gmail.com",
    label: "Email",
    icon: "mail",
  },
];

const trustBadges = [
  "Soporte técnico disponible",
  "Garantía de 1 año",
  "Atención personalizada",
  "Respuesta rápida",
  "Envíos a todo Colombia",
];
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="relative isolate overflow-hidden bg-surface px-6 py-24 text-text sm:py-28 lg:px-10"
>
  <GradientBackground />

  <div
    aria-hidden="true"
    class="absolute left-1/2 top-24 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"
  >
  </div>

  <div
    class="mx-auto grid w-full max-w-6xl gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-16"
  >
    <div class="max-w-3xl lg:sticky lg:top-28">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary"
      >
        Contacto
      </p>
      <h2
        id="contact-heading"
        class="text-4xl font-bold tracking-normal text-text text-balance sm:text-5xl lg:text-6xl"
      >
        Contáctanos
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">
        Estamos disponibles para resolver tus dudas, ayudarte con soporte
        técnico y acompañarte antes y después de tu compra.
      </p>

      <div
        class="mt-8 rounded-[2rem] border border-white/10 bg-white/[0.045] p-5 shadow-2xl shadow-black/25 backdrop-blur sm:p-6"
      >
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-primary"
        >
          Confianza PGLOW
        </p>
        <ul
          class="mt-5 grid gap-3 sm:grid-cols-2"
          aria-label="Información de soporte"
        >
          {
            trustBadges.map((badge) => (
              <li class="flex items-center gap-3 rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-sm font-medium text-white/78">
                <span
                  class="h-2 w-2 shrink-0 rounded-full bg-primary shadow-[0_0_16px_rgba(111,209,215,0.65)]"
                  aria-hidden="true"
                />
                {badge}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      {
        contactMethods.map((method) => (
          <a
            href={method.href}
            target={method.href.startsWith("http") ? "_blank" : undefined}
            rel={method.href.startsWith("http") ? "noreferrer" : undefined}
            class="contact-card group flex min-h-48 flex-col justify-between rounded-[2rem] border border-white/10 bg-surface-elevated/[0.68] p-5 shadow-2xl shadow-black/20 backdrop-blur transition duration-300 ease-out hover:-translate-y-1 hover:border-primary/40 hover:bg-white/[0.06] hover:shadow-[0_24px_90px_rgba(0,0,0,0.38),0_0_42px_rgba(111,209,215,0.12)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:p-6"
            aria-label={`${method.title}: ${method.description}`}
          >
            <span class="flex items-start justify-between gap-4">
              <span class="contact-icon inline-flex h-12 w-12 items-center justify-center rounded-full border border-primary/25 bg-primary/10 text-primary transition duration-300 ease-out group-hover:bg-primary group-hover:text-secondary">
                {method.icon === "whatsapp" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.04 2a9.82 9.82 0 0 0-8.42 14.86L2.5 22l5.26-1.08A9.82 9.82 0 1 0 12.04 2Zm0 1.76a8.06 8.06 0 0 1 6.86 12.3 8.02 8.02 0 0 1-9.58 3.08l-.3-.13-3.83.79.81-3.72-.17-.31a8.06 8.06 0 0 1 6.21-12.01Zm-3.4 4.2c-.17 0-.44.06-.67.32-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.6c.13.17 1.76 2.8 4.34 3.82 2.15.85 2.59.68 3.06.64.47-.04 1.51-.62 1.72-1.22.21-.6.21-1.11.15-1.22-.06-.11-.23-.17-.49-.3-.25-.13-1.5-.74-1.73-.82-.23-.08-.4-.13-.57.13-.17.25-.66.82-.81.99-.15.17-.3.19-.55.06-.25-.13-1.07-.39-2.04-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.52.12-.12.25-.3.38-.45.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.38-.78-1.89-.2-.49-.41-.42-.57-.43h-.5Z" />
                  </svg>
                )}
                {method.icon === "instagram" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <rect
                      x="4"
                      y="4"
                      width="16"
                      height="16"
                      rx="5"
                      stroke="currentColor"
                      stroke-width="2"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="3.5"
                      stroke="currentColor"
                      stroke-width="2"
                    />
                    <circle cx="16.7" cy="7.3" r="1" fill="currentColor" />
                  </svg>
                )}
                {method.icon === "youtube" && (
                  <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M21.58 7.2a3 3 0 0 0-2.11-2.13C17.61 4.56 12 4.56 12 4.56s-5.61 0-7.47.51A3 3 0 0 0 2.42 7.2 31.2 31.2 0 0 0 1.92 12a31.2 31.2 0 0 0 .5 4.8 3 3 0 0 0 2.11 2.13c1.86.51 7.47.51 7.47.51s5.61 0 7.47-.51a3 3 0 0 0 2.11-2.13 31.2 31.2 0 0 0 .5-4.8 31.2 31.2 0 0 0-.5-4.8ZM10 15.5v-7l6 3.5-6 3.5Z" />
                  </svg>
                )}
                {method.icon === "mail" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 6.5h16v11H4v-11Z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linejoin="round"
                    />
                    <path
                      d="m5 7.5 7 5 7-5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </span>
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">
                {method.label}
              </span>
            </span>

            <span class="mt-8 block">
              <span class="block text-xl font-bold tracking-normal text-text">
                {method.title}
              </span>
              <span class="mt-3 block text-sm leading-6 text-muted">
                {method.description}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="mx-auto mt-14 max-w-6xl border-t border-white/10 pt-8">
    <p
      class="max-w-3xl text-lg font-semibold leading-8 text-white/88 text-balance"
    >
      PGLOW — Vapor premium diseñado para una experiencia más limpia, moderna y
      portátil.
    </p>
  </div>

  <style>
    .contact-card:hover .contact-icon {
      transform: translateY(-2px) scale(1.04);
    }

    @media (prefers-reduced-motion: reduce) {
      .contact-card,
      .contact-icon {
        transform: none !important;
        transition: none;
      }
    }
  </style>
</section>
