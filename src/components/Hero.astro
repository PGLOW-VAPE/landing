---
const vapeImage = "https://i.ibb.co/ksxGLRwC/IMG-8067.jpg";
const heroImage = "/assets/hero-bg.jpg";
---

<section
  id="inicio"
  aria-labelledby="hero-heading"
  class="relative isolate flex h-[100dvh] max-h-[100dvh] flex-col overflow-hidden bg-secondary px-0 pb-[clamp(1.25rem,5dvh,3.5rem)] pt-[clamp(5.75rem,13dvh,7.25rem)] text-white sm:px-8 lg:h-screen lg:max-h-screen lg:justify-center lg:px-10 lg:pb-24 lg:pt-28"
>
  <div
    class="absolute inset-0 -z-20 bg-cover bg-center bg-no-repeat scale-[1.03] lg:bg-[center_right_18%]"
    style={`background-image: url('${heroImage}');`}
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-black/85 via-black/70 to-black/85 lg:bg-[linear-gradient(90deg,rgba(0,0,0,0.86)_0%,rgba(0,0,0,0.66)_45%,rgba(0,0,0,0.28)_100%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_38%,rgba(28,77,141,0.26),transparent_42%)] lg:bg-[radial-gradient(circle_at_78%_42%,rgba(28,77,141,0.34),transparent_38%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto flex min-h-0 w-full max-w-6xl flex-1 items-stretch justify-center lg:flex-none lg:items-center lg:justify-start"
  >
    <div
      class="hero-content flex min-h-0 w-full max-w-3xl flex-1 flex-col items-center justify-between gap-[clamp(0.75rem,2.2dvh,1.5rem)] text-center lg:ml-8 lg:flex-none lg:items-start lg:justify-center lg:gap-8 lg:text-left xl:ml-16"
    >
      <div class="w-full shrink-0">
        <p
          class="text-xs font-semibold uppercase tracking-[0.22em] text-white/75 sm:text-sm"
        >
          PGLOW · From Colombia
        </p>

        <h1
          id="hero-heading"
          class="mt-[clamp(0.75rem,2dvh,1.25rem)] max-w-4xl text-[clamp(2.25rem,7.2dvw,3.75rem)] font-bold leading-[1.04] tracking-normal text-white text-balance sm:text-5xl md:text-6xl"
        >
          Una Experiencia Herbal Más limpia
        </h1>
      </div>

      <div
        class="min-h-0 w-full flex-1 overflow-hidden px-5 shadow-lg shadow-secondary/20 lg:h-[clamp(18rem,42vh,30rem)] lg:flex-none"
      >
        <img
          src={vapeImage}
          alt="Imagen del vaporizador PGLOW"
          class="h-full w-full object-cover object-center rounded-2xl"
        />
      </div>

      <div
        class="px-5 flex w-full shrink-0 flex-col items-center gap-[clamp(0.75rem,2dvh,1.35rem)] lg:items-start"
      >
        <p
          class="max-w-2xl text-[clamp(0.98rem,2.4dvh,1rem)] leading-7 text-white/82 md:leading-8 mb-1"
        >
          Saca el máximo provecho a tus hierbas con calentamiento controlado,
          batería de larga duración y diseño compacto.
        </p>

        <div
          class="grid w-full grid-cols-2 gap-3 sm:w-auto sm:flex sm:items-center sm:justify-center lg:justify-start"
        >
          <a
            href="/shop"
            class="inline-flex min-h-11 items-center justify-center rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-secondary shadow-xl shadow-black/25 transition hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:px-7 sm:py-3"
          >
            Comprar ahora
          </a>
          <a
            href="#producto"
            class="inline-flex min-h-11 items-center justify-center rounded-full border border-white/45 bg-white/10 px-5 py-2.5 text-sm font-semibold text-white backdrop-blur transition hover:border-white hover:bg-white/18 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:px-7 sm:py-3"
          >
            Conocer más
          </a>
        </div>

        <ul
          class="flex w-full flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-medium leading-none text-white/90 sm:w-auto sm:gap-x-6 sm:text-sm lg:justify-start"
        >
          <li>160–220°C</li>
          <li>3000mA</li>
          <li>USB-C</li>
          <li>OLED Display</li>
        </ul>
      </div>
    </div>
  </div>

  <style>
    .hero-content {
      animation: hero-content-in 700ms ease-out both;
    }

    @keyframes hero-content-in {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-content {
        animation: none;
      }
    }
  </style>
</section>
