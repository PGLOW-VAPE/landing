---
import GradientBackground from "./GradientBackground.astro";

// Replace these mockup placeholders with final assets in public/media/features/.
const specs = ["160-220°C", "3000mAh", "USB-C", "OLED"];

const features = [
  {
    title: "Calentamiento Controlado",
    description:
      "Ajusta la temperatura desde 160°C hasta 220°C en incrementos de 1°C para una experiencia personalizada.",
    readout: "220°C",
    label: "Precisión",
    detail: "1°C steps",
    mediaPath: "/media/features/temperature-control.jpg",
    mediaAlt: "OLED screen or temperature adjustment close-up placeholder.",
  },
  {
    title: "Sabor Puro",
    description:
      "Vapor limpio y sabroso gracias a la cámara de calentamiento de cerámica y el conducto de vapor de vidrio.",
    readout: "Glass",
    label: "Materiales óptimos",
    detail: "Cerámica + vidrio",
    mediaPath: "/media/features/pure-flavor.jpg",
    mediaAlt: "Macro product detail or vapor shot placeholder.",
  },
  {
    title: "Batería de 3000mAh",
    description:
      "Disfruta de sesiones prolongadas con una potente batería de 3000mAh intercambiable que te acompaña todo el día.",
    readout: "hola",
    label: "Batería potente",
    detail: "Larga duración",
    mediaPath: "/media/features/battery-life.jpg",
    mediaAlt: "Battery visualization or lifestyle usage shot placeholder.",
  },

  {
    title: "Carga USB-C",
    description:
      "Recarga conveniente con el estándar USB-C, compatible con cargadores modernos y power banks.",
    readout: "USB-C",
    label: "Carga fácil",
    detail: "Universal",
    mediaPath: "/media/features/usb-c-charging.jpg",
    mediaAlt: "Charging close-up with cable connected placeholder.",
  },
  {
    title: "Interfaz OLED Intuitiva",
    description:
      "Pantalla OLED clara y fácil de navegar que muestra temperatura, batería y modo en tiempo real.",
    readout: "OLED",
    label: "Pantalla avanzada",
    detail: "Ajusta y monitorea",
    mediaPath: "/media/features/oled-display.jpg",
    mediaAlt: "Screen UI mockup or animated display placeholder.",
  },
  {
    title: "Modos de Uso Versátiles",
    description:
      "Elige entre modo sesión para calentamiento continuo o modo por plones para calentar únicamente al mantener presionado el botón.",
    readout: "Cargando plones",
    label: "Modos de uso",
    detail: "Sesión o por plones",
    mediaPath: "/media/features/heating-modes.jpg",
    mediaAlt:
      "Mode selection interaction or split layout visualization placeholder.",
  },
  {
    title: "Cuerpo en PETG impreso en 3D",
    description:
      "Construcción robusta y ligera con PETG de alta calidad, impreso en 3D para detalles precisos y diseño ergonómico.",
    readout: "Alloy",
    label: "Construcción premium",
    detail: "portable",
    mediaPath: "/media/features/build-quality.jpg",
    mediaAlt: "Premium close-up angles and material details placeholder.",
  },
  {
    title: "Garantía y Soporte Confiable",
    description:
      "Respaldado por 1 año de garantía y soporte técnico disponible para asegurar tu satisfacción y confianza en PGLOW.",
    readout: "Care",
    label: "Soporte dedicado",
    detail: "Garantía incluida",
    mediaPath: "/media/features/warranty-support.jpg",
    mediaAlt: "Minimal trust badge or support illustration placeholder.",
  },
];
---

<section
  id="features"
  aria-labelledby="features-heading"
  class="relative isolate overflow-hidden bg-surface px-6 py-24 text-text sm:py-28 lg:px-10"
>
  <GradientBackground />

  <div class="mx-auto w-full max-w-6xl">
    <div class="max-w-3xl">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary"
      >
        Características
      </p>
      <h2
        id="features-heading"
        class="text-4xl font-bold tracking-normal text-text text-balance sm:text-5xl lg:text-6xl"
      >
        Diseñado para una experiencia premium
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">
        El PGLOW combina tecnología avanzada, materiales de alta calidad y un
        diseño intuitivo. Desde el control de temperatura hasta la batería de
        larga duración.
      </p>
    </div>

    <div class="mt-8 space-y-14 sm:mt-20 lg:space-y-24">
      <!-- <div class=""> -->
      {
        features.map((feature, index) => (
          <article
            class="feature-block grid gap-8 border-t border-white/10 pt-10 lg:grid-cols-[0.95fr_1fr] lg:items-center lg:gap-16"
            aria-labelledby={`feature-${index}`}
          >
            <figure
              class:list={[
                "feature-media relative aspect-[4/3] overflow-hidden rounded-[2rem] border border-white/10 bg-surface-elevated/[0.62] shadow-[0_24px_90px_rgba(0,0,0,0.35),0_0_42px_rgba(111,209,215,0.10)] transition duration-500 ease-out",
                index % 2 === 1 && "lg:order-2",
              ]}
              data-media-placeholder={feature.mediaPath}
            >
              <div
                aria-hidden="true"
                class="absolute inset-0 bg-[radial-gradient(circle_at_28%_24%,rgba(111,209,215,0.22),transparent_34%),linear-gradient(135deg,rgba(255,255,255,0.10),rgba(255,255,255,0.02))]"
              />
              <div
                aria-hidden="true"
                class="absolute -right-16 -top-20 h-44 w-44 rounded-full border border-primary/20 bg-primary/10 blur-3xl"
              />

              <div class="relative flex h-full flex-col justify-between p-5 sm:p-7">
                <div class="flex items-center justify-between gap-4">
                  <span class="rounded-full border border-white/10 bg-white/[0.07] px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-white/70">
                    {feature.label}
                  </span>
                  <span class="text-sm font-semibold text-primary">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>

                <div class="flex items-center justify-center py-4">
                  <div class="feature-device relative flex h-44 w-28 flex-col rounded-[2rem] border border-white/12 bg-[linear-gradient(145deg,rgba(255,255,255,0.16),rgba(255,255,255,0.035))] p-3 shadow-2xl shadow-black/45 transition duration-500 ease-out sm:h-52 sm:w-32">
                    <div class="flex flex-1 flex-col justify-between rounded-[1.35rem] border border-white/10 bg-black/55 p-3">
                      <div class="flex items-center justify-between">
                        <span class="h-1.5 w-1.5 rounded-full bg-primary" />
                        <span class="h-1.5 w-6 rounded-full bg-white/20" />
                      </div>
                      <div>
                        <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/45">
                          PGLOW
                        </p>
                        <p class="mt-2 text-2xl font-bold tracking-normal text-primary sm:text-3xl">
                          {feature.readout}
                        </p>
                      </div>
                      <div class="space-y-1.5">
                        <span class="block h-1.5 rounded-full bg-primary/75" />
                        <span class="block h-1.5 w-2/3 rounded-full bg-white/18" />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-3 gap-2 text-center text-xs font-semibold text-white/68">
                  <span class="rounded-full border border-white/10 bg-black/25 px-3 py-2">
                    PGLOW
                  </span>
                  <span class="rounded-full border border-white/10 bg-black/25 px-3 py-2">
                    {feature.detail}
                  </span>
                  <span class="rounded-full border border-white/10 bg-black/25 px-3 py-2">
                    Ready
                  </span>
                </div>
              </div>

              <figcaption class="sr-only">{feature.mediaAlt}</figcaption>
            </figure>

            <div class:list={["max-w-xl", index % 2 === 1 && "lg:order-1"]}>
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
                {feature.detail}
              </p>
              <h3
                id={`feature-${index}`}
                class="mt-4 text-3xl font-bold tracking-normal text-text text-balance sm:text-4xl"
              >
                {feature.title}
              </h3>
              <p class="mt-4 text-base leading-7 text-muted sm:text-lg">
                {feature.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <ul
      class="mt-8 flex flex-wrap gap-2 text-xs font-semibold tracking-[0.14em] text-white/70"
      aria-label="Product specifications"
    >
      {
        specs.map((spec) => (
          <li class="rounded-full border border-white/10 bg-white/[0.06] px-4 py-2">
            {spec}
          </li>
        ))
      }
    </ul>

    <style>
      .feature-block:hover .feature-media {
        border-color: color-mix(in srgb, var(--color-primary) 38%, transparent);
        transform: translateY(-4px);
      }

      .feature-block:hover .feature-device {
        transform: translateY(-6px) rotate(-2deg);
      }

      @media (prefers-reduced-motion: reduce) {
        .feature-media,
        .feature-device {
          transform: none !important;
          transition: none;
        }
      }
    </style>
  </div>
</section>
