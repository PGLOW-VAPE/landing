---
const whatsappHref = "https://wa.me/XXXXXXXXXXX";
const buyHref = "https://pglow.papedir.com";
---

<aside
  data-footer
  data-hidden="false"
  class="fixed inset-x-0 bottom-0 z-50 transition duration-300 ease-out data-[hidden=true]:translate-y-[calc(100%+1.5rem)] data-[hidden=true]:opacity-0 motion-reduce:transition-none sm:px-6 lg:px-8"
  aria-label="Acciones rápidas"
>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-3 rounded-none bg-secondary/[0.88] px-3 py-2.5 text-text shadow-2xl shadow-black/30 backdrop-blur-xl supports-[backdrop-filter]:bg-secondary/[0.72] sm:px-4"
  >
    <a
      href="#inicio"
      class="flex min-w-0 items-center gap-2 rounded-full pr-1 transition hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      aria-label="Volver al inicio de PGLOW"
    >
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary"
      >
        <img
          src="/favicon.svg"
          alt="PGLOW logo"
          class="h-5 w-5 [filter:brightness(0)]"
        />
      </span>
      <span
        class="truncate text-sm font-semibold leading-none text-white sm:text-base"
      >
        Pure flavor. Precise control.
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noreferrer"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-primary/30 bg-primary/10 text-primary transition hover:bg-primary hover:text-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        aria-label="Contactar por WhatsApp"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12.04 2a9.82 9.82 0 0 0-8.42 14.86L2.5 22l5.26-1.08A9.82 9.82 0 1 0 12.04 2Zm0 1.76a8.06 8.06 0 0 1 6.86 12.3 8.02 8.02 0 0 1-9.58 3.08l-.3-.13-3.83.79.81-3.72-.17-.31a8.06 8.06 0 0 1 6.21-12.01Zm-3.4 4.2c-.17 0-.44.06-.67.32-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.6c.13.17 1.76 2.8 4.34 3.82 2.15.85 2.59.68 3.06.64.47-.04 1.51-.62 1.72-1.22.21-.6.21-1.11.15-1.22-.06-.11-.23-.17-.49-.3-.25-.13-1.5-.74-1.73-.82-.23-.08-.4-.13-.57.13-.17.25-.66.82-.81.99-.15.17-.3.19-.55.06-.25-.13-1.07-.39-2.04-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.52.12-.12.25-.3.38-.45.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.38-.78-1.89-.2-.49-.41-.42-.57-.43h-.5Z"
          ></path>
        </svg>
      </a>
      <a
        target="_blank"
        href={buyHref}
        rel="noreferrer"
        class="inline-flex min-h-10 items-center justify-center rounded-full bg-primary px-5 text-sm font-semibold text-secondary shadow-lg shadow-primary/15 transition hover:bg-white hover:text-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
      >
        Comprar
      </a>
    </div>
  </div>
</aside>

<script>
  (() => {
    const footer = document.querySelector("[data-footer]");

    if (!(footer instanceof HTMLElement)) {
      return;
    }

    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateFooter = () => {
      const currentScrollY = window.scrollY;
      const isAtTop = currentScrollY <= 8;
      const isScrollingDown = currentScrollY > lastScrollY;
      footer.dataset.hidden = String(!isAtTop && isScrollingDown);

      // const hasScrolledMeaningfully =
      //   Math.abs(currentScrollY - lastScrollY) > 2;

      // if (isAtTop) {
      //   footer.dataset.hidden = "true";
      // } else if (hasScrolledMeaningfully) {
      //   footer.dataset.hidden = String(isScrollingDown);
      // }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateFooter);
          ticking = true;
        }
      },
      { passive: true },
    );
  })();
</script>
