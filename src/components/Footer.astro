---
const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#product", label: "Producto" },
  { href: "#caracteristicas", label: "Características" },
  { href: "#beneficios", label: "Beneficios" },
  { href: "#tutorial", label: "Tutorial" },
  { href: "#contacto", label: "Contacto" },
];
---

<header
  data-footer
  data-hidden="false"
  class="fixed inset-x-0 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-50 px-4 py-3 transition duration-300 ease-out data-[hidden=true]:translate-y-[calc(100%+1.5rem)] data-[hidden=true]:opacity-0 motion-reduce:transition-none sm:px-6 lg:px-8"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-white/10 bg-secondary/[0.88] px-4 py-3 text-text shadow-2xl shadow-black/30 backdrop-blur-xl supports-[backdrop-filter]:bg-secondary/[0.72]"
    aria-label="Navegacion inferior"
  >
    <a
      href="#inicio"
      class="inline-flex items-center rounded-full text-lg font-bold tracking-normal text-text transition hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <div class="flex items-center gap-1">
        <span
          aria-hidden="true"
          class="h-6 w-6 bg-primary [mask:url('/favicon.svg')_center/contain_no-repeat] [-webkit-mask:url('/favicon.svg')_center/contain_no-repeat]"
        ></span>

        <!-- <h2 class="text-text">PGLOW · COLOMBIA</h2> -->
        <h2 class="text-text">PGLOW</h2>
      </div>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-3 py-2 text-sm font-medium text-white/72 transition hover:bg-white/8 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://pglow.papedir.com"
      rel="noreferrer"
      class="hidden rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-secondary shadow-sm shadow-primary/20 transition hover:bg-white hover:text-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:inline-flex"
    >
      Comprar ahora
    </a>

    <button
      type="button"
      data-footer-menu-toggle
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-text transition hover:bg-white/10 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:hidden"
      aria-controls="footer-mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menu"
    >
      <svg
        data-footer-menu-icon-open
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <svg
        data-footer-menu-icon-close
        class="hidden h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M6 6l12 12M18 6L6 18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>

  <div
    id="footer-mobile-menu"
    data-footer-mobile-menu
    data-open="false"
    class="pointer-events-none absolute inset-x-4 bottom-[calc(100%+0.5rem)] origin-bottom scale-95 rounded-2xl border border-white/10 bg-surface/95 p-3 opacity-0 shadow-2xl shadow-black/40 backdrop-blur-xl transition duration-200 ease-out data-[open=true]:pointer-events-auto data-[open=true]:scale-100 data-[open=true]:opacity-100 md:hidden"
    aria-hidden="true"
    inert
  >
    <div class="flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-4 py-3 text-sm font-medium text-white/78 transition hover:bg-primary/12 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            {link.label}
          </a>
        ))
      }
      <a
        target="_blank"
        href="https://pglow.papedir.com"
        rel="noreferrer"
        class="mt-2 rounded-xl bg-primary px-4 py-3 text-center text-sm font-semibold text-secondary transition hover:bg-white hover:text-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        Comprar ahora
      </a>
    </div>
  </div>
</header>

<script>
  (() => {
    const footer = document.querySelector("[data-footer]");
    const menu = document.querySelector("[data-footer-mobile-menu]");
    const toggle = document.querySelector("[data-footer-menu-toggle]");
    const openIcon = document.querySelector("[data-footer-menu-icon-open]");
    const closeIcon = document.querySelector("[data-footer-menu-icon-close]");

    if (
      !(footer instanceof HTMLElement) ||
      !(menu instanceof HTMLElement) ||
      !(toggle instanceof HTMLButtonElement)
    ) {
      return;
    }

    let isMenuOpen = false;
    let lastScrollY = window.scrollY;
    let ticking = false;

    const setMenuOpen = (open: boolean) => {
      isMenuOpen = open;
      menu.dataset.open = String(open);
      menu.setAttribute("aria-hidden", String(!open));
      menu.toggleAttribute("inert", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menu" : "Abrir menu");
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);

      if (open) {
        footer.dataset.hidden = "false";
      }
    };

    const updateFooter = () => {
      const currentScrollY = window.scrollY;
      const isAtTop = currentScrollY <= 8;
      const isScrollingDown = currentScrollY > lastScrollY;
      const hasScrolledMeaningfully =
        Math.abs(currentScrollY - lastScrollY) > 2;

      if (isAtTop) {
        footer.dataset.hidden = "true";
      } else if (hasScrolledMeaningfully) {
        footer.dataset.hidden = String(isScrollingDown && !isMenuOpen);
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    toggle.addEventListener("click", () => {
      setMenuOpen(!isMenuOpen);
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateFooter);
          ticking = true;
        }
      },
      { passive: true },
    );
  })();
</script>
